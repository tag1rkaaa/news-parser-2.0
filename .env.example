# --- Telegram ---
# Get the token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=8990480791:AAFKbtTIPGsGtkpnhmQmZSFoF_afDQu8zx0
# The news channel ID (negative for channels, e.g. -1002033934142)
TELEGRAM_CHANNEL_ID=-1004486404815
# Separate chat that receives alert_watcher messages (can be the same)
TELEGRAM_ALERT_CHAT_ID=-1004486404815
# Hard cap on outbound message rate (per second, per bot)
TELEGRAM_RATE_LIMIT_PER_SEC=0.5
# SOCKS5 proxy for Telegram (optional)
TELEGRAM_PROXY_HOST=117.55.202.206
TELEGRAM_PROXY_PORT=8118

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_DEDUP_TTL_SECONDS=604800

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=parsed_data

# --- Prometheus / Grafana ---
PROMETHEUS_PORT=8000
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Alert thresholds ---
ALERT_LAST_SUCCESS_MAX_AGE_SECONDS=21600   # 6 h
ALERT_ERROR_RATE_THRESHOLD=0.5
ALERT_UNHEALTHY_SPIDER_RATIO=0.3
ALERT_WATCHER_INTERVAL_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/newsparser.log
LOG_ROTATION_BYTES=52428800   # 50 MB
LOG_ROTATION_BACKUPS=5

# --- Per-domain delays (JSON dict, optional) ---
# DOMAIN_DOWNLOAD_DELAYS={"tass.ru": 1.0, "kommersant.ru": 2.0}
