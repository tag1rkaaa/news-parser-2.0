{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Items scraped per minute (per spider)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (spider) (rate(newsparser_items_scraped_total[5m])) * 60",
          "legendFormat": "{{spider}}"
        }
      ]
    },
    {
      "title": "Dropped items by reason",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (reason) (rate(newsparser_items_dropped_total[5m])) * 60",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "title": "Errors per spider (5m rate)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (spider, type) (rate(newsparser_errors_total[5m]))",
          "legendFormat": "{{spider}} / {{type}}"
        }
      ]
    },
    {
      "title": "Spider health",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
            {"type": "value", "options": {"1": {"text": "DEGRADED", "color": "yellow"}}},
            {"type": "value", "options": {"2": {"text": "HEALTHY", "color": "green"}}}
          ]
        }
      },
      "targets": [
        {"expr": "newsparser_spider_health", "legendFormat": "{{spider}}"}
      ]
    },
    {
      "title": "Time since last successful run (hours)",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 6}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "(time() - newsparser_spider_last_success_timestamp) / 3600",
          "legendFormat": "{{spider}}"
        }
      ]
    },
    {
      "title": "p95 response latency by domain",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, domain) (rate(newsparser_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{domain}}"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["newsparser"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Newsparser Overview",
  "uid": "newsparser-overview",
  "version": 1
}
